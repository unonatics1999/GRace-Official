# SQLite file for local development, relative to prisma/schema.prisma.
# Production: a PostgreSQL URL (and set provider = "postgresql" in the schema).
DATABASE_URL="file:./dev.db"

# Signs session cookies. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
