# ── Database ─────────────────────────────────────────────────────────────
# Local development: a SQLite file, relative to prisma/schema.prisma. One connection, so
# concurrent writes queue instead of failing (SQLite allows a single writer).
# Production: a PostgreSQL URL, e.g. postgresql://user:pass@host:5432/downtime
# (also set provider = "postgresql" in prisma/schema.prisma; see README).
DATABASE_URL="file:./dev.db?connection_limit=1&socket_timeout=20"

# ── Sessions ─────────────────────────────────────────────────────────────
# Signs login cookies. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ── App ──────────────────────────────────────────────────────────────────
# Public URL, used for PayMongo return links. Required in production.
APP_URL="http://localhost:3000"

# ── PayMongo (https://dashboard.paymongo.com → Developers) ───────────────
# Leave both empty in development to simulate payments. Required in production.
# Use sk_test_… keys until you go live.
PAYMONGO_SECRET_KEY=""
# From the webhook you create for <APP_URL>/api/webhooks/paymongo
# (event: checkout_session.payment.paid).
PAYMONGO_WEBHOOK_SECRET=""

# ── File storage ─────────────────────────────────────────────────────────
# Where vehicle photos, handoff photos and verification documents are saved.
# Must be a persistent disk in production (or swap src/lib/storage.ts for S3).
STORAGE_DIR="./storage"

# ── Help-center AI assistant ─────────────────────────────────────────────
# Anthropic API key (https://console.anthropic.com). Without it, the assistant answers with
# the closest help articles instead of AI.
ANTHROPIC_API_KEY=""
